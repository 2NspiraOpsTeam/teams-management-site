{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teams-development-runtime",
  "account_id": "8fbe09502d38e82ab1b3d51f8eb7a1c6",
  "main": "deployment/preview-runtime/entry.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_ENVIRONMENT": "development",
    "NEXT_PUBLIC_TEAMS_PORTAL_ORIGIN": "https://teams-management-development.pages.dev",
    "PROPERTY_OPERATIONS_ENABLED": "1",
    "TENANT_LEASES_ENABLED": "1",
    "TENANT_MANUAL_IMPORT_DATABASE_ID": "29dfe758-69b1-4465-b74e-101d48c53f7e",
    "ADMIN_AUTH_FROM": "do-not-reply@waterbearmecca.com",
    "TENANT_AUTH_FROM": "do-not-reply@waterbearmecca.com",
    "INQUIRY_FROM": "do-not-reply@waterbearmecca.com",
    "TEAMS_RELEASE_SHA": "resident-home-20261018",
    "TEAMS_MIGRATION_WRITE_FREEZE": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teams-development-db",
      "database_id": "29dfe758-69b1-4465-b74e-101d48c53f7e"
    }
  ]
}
