{
  "name": "teams-management",
  "version": "1.0.0",
  "private": true,
  "description": "Teams Management Platform - Phase 1 Portfolio Website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next-on-pages",
    "build:preview:pages": "NEXT_PUBLIC_PREVIEW_PORTFOLIO=1 npm run build:pages",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:preview": "npm run build:preview:pages && wrangler pages deploy .vercel/output/static --project-name teams-management-preview --branch preview"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/leaflet": "^1.9.22",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "next": "^15.4.11",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "wrangler": "^3.114.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
