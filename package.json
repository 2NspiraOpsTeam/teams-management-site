{
  "name": "teams-management",
  "version": "1.0.0",
  "private": true,
  "description": "Teams Management Platform - Phase 1 Portfolio Website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:d1:local": "bash scripts/setup-local-qa-d1.sh",
    "build:worker": "opennextjs-cloudflare build --config wrangler.worker.jsonc",
    "build:preview:worker": "NEXT_PUBLIC_PREVIEW_PORTFOLIO=1 opennextjs-cloudflare build --config wrangler.worker.jsonc && node scripts/images/stage.cjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.1",
    "@opennextjs/cloudflare": "1.20.12",
    "@types/leaflet": "^1.9.22",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "^9.3.12",
    "wrangler": "4.154.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30",
      "sharp": "0.35.5"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
